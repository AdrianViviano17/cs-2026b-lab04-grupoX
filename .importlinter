[importlinter]
root_package = src

[importlinter:contract:capas]
name = FF-01 Capas del Monolito Modular sin Ciclos (ADR-001)
type = layers
layers =
    src.reportes.servicio
    src.reportes.estrategias | src.reportes.estados | src.reportes.eventos | src.reportes.ia
    src.reportes.externos

[importlinter:contract:puertos]
name = FF-02 Solo la Capa de Servicio conoce Adaptadores de Infraestructura (ADR-005)
type = forbidden
source_modules =
    src.reportes.estados
    src.reportes.ia
forbidden_modules =
    src.reportes.externos
