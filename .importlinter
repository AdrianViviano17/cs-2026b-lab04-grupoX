[importlinter]
root_package = src

[importlinter:contract:capas]
name = FF-01 Capas del Monolito Modular sin Ciclos (ADR-001)
type = layers
layers =
    reportes.servicio
    reportes.estrategias | reportes.estados | reportes.eventos | reportes.ia
    reportes.externos

[importlinter:contract:puertos]
name = FF-02 Solo la Capa de Servicio conoce Adaptadores de Infraestructura (ADR-005)
type = forbidden
source_modules =
    reportes.estados
    reportes.ia
forbidden_modules =
    reportes.externos
